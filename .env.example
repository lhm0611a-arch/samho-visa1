# ==============================================================================
# HD현대삼호 외국인 근로자 비자발급 자동화 시스템 - 환경 변수 설정 (.env.example)
# Render (render.com) 배포 시 대시보드의 'Environment' 탭에 아래 키들을 등록하세요.
# ==============================================================================

# [필수 1] Google Gemini AI API 키
# 외국인등록증/여권 자동 OCR 판독 및 서류 일괄 교차검증에 사용됩니다.
# Google AI Studio (https://aistudio.google.com/)에서 무료 발급 가능합니다.
GEMINI_API_KEY=""

# [선택 2] 서버 포트 (Render 배포 시 Render 시스템이 자동으로 주입하므로 비워두셔도 됩니다)
PORT=3000
NODE_ENV=production

# [선택 3] Firebase 클라우드 DB 연동 설정
# 근로자 명부를 클라우드 Firestore에 동기화할 때 사용됩니다.
# (미입력 시에도 브라우저 로컬 스토리지로 100% 정상 작동합니다)
# Firebase 콘솔 (https://console.firebase.google.com/) > 프로젝트 설정에서 확인 가능
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

